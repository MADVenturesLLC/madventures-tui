{
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ES2022",
    "module": "ESNext",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "jsxImportSource": "@opentui/react",
    "allowJs": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": false,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false,
    "paths": {
      "@madventures/protocol": ["./packages/protocol/src/index.ts"],
      "@madventures/policy": ["./packages/policy/src/index.ts"],
      "@madventures/ledger": ["./packages/ledger/src/index.ts"],
      "@madventures/artifact-store": ["./packages/artifact-store/src/index.ts"],
      "@madventures/broker": ["./packages/broker/src/index.ts"],
      "@madventures/adapter-claude-code": ["./packages/adapter-claude-code/src/index.ts"],
      "@madventures/adapter-antigravity": ["./packages/adapter-antigravity/src/index.ts"],
      "@madventures/pty-host": ["./packages/pty-host/src/index.ts"]
    }
  }
}