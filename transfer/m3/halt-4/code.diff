new file mode 100644
index 0000000..9add05b
--- /dev/null
+++ b/test/phase3b/dispatch-observation.ts
@@ -0,0 +1,51 @@
+import type { BrokerCommand } from "@madventures/broker";
+import { encodeUserInput as claudeInput } from "../../packages/adapter-claude-code/src/live";
+import { encodeUserInput as madvInput } from "../../packages/adapter-madv-surface/src/index";
+import { pendingAckRegisteredForTest } from "../../packages/broker/src/pty-host-supervisor";
+import { observed, openTransport } from "./transport";
+import type { Surface } from "./end-stand-in";
+
+export const encodedLine = (surface: Surface, line: string) =>
+  new TextEncoder().encode((surface === "claude-code" ? claudeInput : madvInput)(line));
+
+export async function dispatchTranscript(surface: Surface) {
+  const t = await openTransport(surface);
+  const host = t.build.state.hosts.find(h => h.executionId === t.writer.execution_id)!;
+  const wire = host.handle.send;
+  const frames: { kind: string; pending: boolean; bytes?: number[]; cols?: number; rows?: number }[] = [];
+  host.handle.send = frame => {
+    if (frame.kind === "input" || frame.kind === "resize") {
+      frames.push({ kind: frame.kind, pending: pendingAckRegisteredForTest(host.handle),
+        ...(frame.kind === "resize" ? { cols: frame.cols, rows: frame.rows } : { bytes: [...frame.bytes] }) });
+    }
+    wire(frame);
+  };
+  try {
+    const snapshot = await t.client.getSnapshot();
+    const base = { sessionId: t.sessionId, executionId: t.writer.execution_id, fencingToken: snapshot.fencingToken! };
+    const bytes = encodedLine(surface, "offline transport");
+    const commands: BrokerCommand[] = [
+      { ...base, kind: "pty_resize", commandId: "offline-resize", cols: 73, rows: 19 },
+      { ...base, kind: "pty_input", commandId: "offline-input", bytes },
+    ];
+    const outcomes = [];
+    for (const command of commands) {
+      process.kill(host.hostPid, "SIGSTOP");
+      let settled = false;
+      let pending: Promise<Awaited<ReturnType<typeof t.client.request>>>;
+      let registered: boolean, answeredWhileStopped: boolean;
+      try {
+        pending = t.client.request(command).then(answer => { settled = true; return answer; });
+        await Bun.sleep(20);
+        registered = pendingAckRegisteredForTest(host.handle);
+        answeredWhileStopped = settled;
+      } finally { process.kill(host.hostPid, "SIGCONT"); }
+      outcomes.push({ kind: command.kind, registered, answeredWhileStopped, acceptedAfterResume: (await pending).ok });
+    }
+    await observed(() => t.inputs(surface).length === 1);
+    return { surface, frames, outcomes, child: t.inputs(surface)[0]!, expected: [...bytes] };
+  } finally {
+    host.handle.send = wire;
+    await t.close();
+  }
+}
