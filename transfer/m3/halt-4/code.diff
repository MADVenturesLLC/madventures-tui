+import { expect, test } from "bun:test";
+import { act } from "react";
+import { BROKER_ERROR_CODES } from "../../packages/broker/src/client";
+import { encodedLine } from "./dispatch-observation";
+import { inputView } from "./input-view";
+import { paneClient, paneSnapshot } from "./pane-client";
+
+test("only Enter submits one encoded focused line and other focus sends nothing", async () => {
+  const f = paneClient();
+  const v = await inputView(f.client);
+  const inputs = () => f.commands.filter(c => c.kind === "pty_input");
+  try {
+    await v.key("a");
+    await v.key("x");
+    await v.key("BACKSPACE");
+    expect(inputs()).toHaveLength(0);
+    await v.key("4", true);
+    await v.key("b");
+    expect(inputs()).toHaveLength(0);
+    await v.key("RETURN");
+    await v.key("RETURN");
+    await v.key("1", true);
+    await act(async () => { f.setSnapshot(paneSnapshot({ fencingToken: 39 })); });
+    await v.key("c");
+    await v.key("RETURN");
+    await v.key("RETURN");
+    for (const seat of ["3", "5"]) {
+      await v.key(seat, true);
+      await v.line("z");
+    }
+    expect(inputs()).toHaveLength(2);
+    expect(inputs()[0]).toMatchObject({ sessionId: "offline-panes", executionId: "reviewer", fencingToken: 17,
+      bytes: encodedLine("madv-surface", "b") });
+    expect(inputs()[1]).toMatchObject({ sessionId: "offline-panes", executionId: "builder", fencingToken: 39,
+      bytes: encodedLine("claude-code", "ac") });
+  } finally { await v.close(); f.close(); }
+});
+
+test("only the active focused writer resizes at a changed pane size", async () => {
+  for (const writer of ["builder", "reviewer"]) {
+    const f = paneClient(paneSnapshot({ activeWriterExecutionId: writer }));
+    const v = await inputView(f.client);
+    const requests = () => f.commands.filter(c => c.kind === "pty_resize");
+    const focus = writer === "builder" ? "1" : "4";
+    const other = writer === "builder" ? "4" : "1";
+    const dimensions = () => {
+      const node = v.renderer.root.findDescendantById(writer === "builder" ? "claude-output" : "second-output")!;
+      return { cols: node.width, rows: node.height };
+    };
+    const resize = async (cols: number, rows: number) => {
+      await act(async () => { v.resize(cols, rows); });
+      await v.flush();
+    };
+    try {
+      if (writer === "reviewer") expect(requests()).toHaveLength(0);
+      await v.key(focus, true);
+      expect(requests()).toHaveLength(1);
+      expect(requests()[0]).toMatchObject({ ...dimensions(), executionId: writer, sessionId: "offline-panes", fencingToken: 17 });
+      await resize(167, 49);
+      expect(requests()).toHaveLength(2);
+      expect(requests()[1]).toMatchObject(dimensions());
+      await v.key(other, true);
+      await resize(136, 36);
+      await v.key("3", true);
+      await resize(145, 40);
+      await v.key("5", true);
+      await resize(151, 43);
+      expect(requests()).toHaveLength(2);
+      await v.key(focus, true);
+      expect(requests()).toHaveLength(3);
+      expect(requests()[2]).toMatchObject(dimensions());
+      await v.key(other, true);
+      await v.key(focus, true);
+      expect(requests()).toHaveLength(3);
+      expect(requests().every(c => c.executionId === writer)).toBe(true);
+    } finally { await v.close(); f.close(); }
+  }
+});
+
+test("each refusal is shown once without retry and no token sends nothing", async () => {
+  const f = paneClient();
+  let refusal = BROKER_ERROR_CODES[0] as typeof BROKER_ERROR_CODES[number];
+  const original = f.client.request;
+  f.client.request = async command => {
+    const accepted = await original(command);
+    return command.kind === "pty_input" ? { ok: false, commandId: command.commandId, error: refusal, detail: "offline refusal" } : accepted;
+  };
+  const v = await inputView(f.client);
+  try {
+    for (const code of BROKER_ERROR_CODES) {
+      refusal = code;
+      const count = f.commands.length;
+      await v.line("x");
+      expect(v.captureCharFrame()).toContain(code.replaceAll("_", " ").toUpperCase());
+      expect(f.commands.length).toBe(count + 1);
+    }
+    await act(async () => { f.setSnapshot(paneSnapshot({ fencingToken: null })); });
+    const count = f.commands.length;
+    await v.line("x");
+    expect(v.captureCharFrame()).toContain("NO TOKEN");
+    expect(f.commands.length).toBe(count);
+  } finally { await v.close(); f.close(); }
+});
