index 0000000..9457276
--- /dev/null
+++ b/apps/madbridge/src/tui/live/line-buffer.ts
@@ -0,0 +1,85 @@
+import type { BrokerClient, BrokerCommand } from "@madventures/broker";
+import { encodeUserInput as encodeClaude } from "../../../../../packages/adapter-claude-code/src/live";
+import { encodeUserInput as encodeMadv } from "../../../../../packages/adapter-madv-surface/src/index";
+
+type Surface = "claude-code" | "madv-surface";
+type Size = { cols: number; rows: number };
+type Client = Pick<BrokerClient, "getSnapshot" | "request">;
+
+export class PaneLine {
+  private before: string[] = [];
+  private after: string[] = [];
+  private sizes = new Map<string, Size>();
+  private readonly listeners = new Set<() => void>();
+  private word = "";
+  private latest = 0;
+
+  constructor(private readonly surface: Surface, private readonly client: Client) {}
+  readonly status = () => this.word;
+  readonly subscribe = (listener: () => void) => {
+    this.listeners.add(listener);
+    return () => { this.listeners.delete(listener); };
+  };
+
+  edit(key: string): void {
+    if (key === "\r" || key === "\n") {
+      const line = this.before.join("") + this.after.reverse().join("");
+      this.before = [];
+      this.after = [];
+      if (line.length > 0) void this.command({ line });
+    } else if (key === "\x7f" || key === "\b") {
+      this.before.pop();
+    } else if (key === "\x1b[D") {
+      const ch = this.before.pop();
+      if (ch !== undefined) this.after.push(ch);
+    } else if (key === "\x1b[C") {
+      const ch = this.after.pop();
+      if (ch !== undefined) this.before.push(ch);
+    } else if (key === "\x1b[3~") {
+      this.after.pop();
+    } else if (!/[\x00-\x1f\x7f]/u.test(key)) {
+      for (const ch of key) this.before.push(ch);
+    }
+  }
+
+  resize(cols: number, rows: number, focused: () => boolean): void {
+    if (cols > 0 && rows > 0 && focused()) void this.command({ size: { cols, rows }, focused });
+  }
+
+  private show(word: string): void {
+    if (this.word === word) return;
+    this.word = word;
+    for (const notify of this.listeners) notify();
+  }
+
+  private async command(action: { line: string } | { size: Size; focused(): boolean }): Promise<void> {
+    let order: number | undefined;
+    try {
+      const snapshot = await this.client.getSnapshot();
+      if ("size" in action && !action.focused()) return;
+      const execution = snapshot.executions?.find(entry => entry.identity.surface === this.surface);
+      const id = execution?.identity.execution_id;
+      if (!id) { this.show("EXECUTION NOT FOUND"); return; }
+      if ("size" in action && snapshot.activeWriterExecutionId !== id) return;
+      if (snapshot.connected !== true) { this.show(snapshot.connected === false ? "STREAM ENDED" : "NO CONNECTION"); return; }
+      if (snapshot.fencingToken === null) { this.show("NO TOKEN"); return; }
+      const base = { commandId: crypto.randomUUID(), sessionId: snapshot.sessionId, executionId: id,
+        fencingToken: snapshot.fencingToken };
+      let command: BrokerCommand;
+      if ("line" in action) {
+        const encoded = this.surface === "claude-code" ? encodeClaude(action.line) : encodeMadv(action.line);
+        command = { ...base, kind: "pty_input", bytes: new TextEncoder().encode(encoded) };
+      } else {
+        const last = this.sizes.get(id);
+        if (last?.cols === action.size.cols && last.rows === action.size.rows) return;
+        this.sizes.set(id, action.size);
+        command = { ...base, kind: "pty_resize", ...action.size };
+      }
+      order = ++this.latest;
+      const result = await this.client.request(command);
+      if (order === this.latest) this.show(result.ok ? "" : result.error.replaceAll("_", " ").toUpperCase());
+    } catch {
+      if (order === undefined || order === this.latest) this.show("HOST UNAVAILABLE");
+    }
+  }
+}
diff --git a/apps/madbridge/src/tui/live/retention.ts b/apps/madbridge/src/tui/live/retention.ts
new file mode 100644
index 0000000..82204e4
--- /dev/null
+++ b/apps/madbridge/src/tui/live/retention.ts
@@ -0,0 +1,127 @@
+import { useSyncExternalStore } from "react";
+import type { BrokerClient } from "@madventures/broker";
+
+export const MAX_PANE_LINES = 10_000;
+export const MAX_PANE_BYTES = 2_097_152;
+
+interface Chunk {
+  start: number;
+  bytes: Uint8Array;
+  count: number;
+}
+
+/** Absolute line starts form a ring. CRLF is one terminator across frame boundaries. */
+export class PaneRetention {
+  private readonly starts = new Float64Array(MAX_PANE_LINES);
+  private lineCount = 0;
+  private nextStartsLine = true;
+  private previousCR = false;
+  private readonly chunks = new Map<number, Chunk>();
+  private last: Chunk | undefined;
+  receivedFrames = 0;
+  receivedBytes = 0;
+  retainedFrames = 0;
+  retainedBytes = 0;
+
+  append(bytes: Uint8Array): void {
+    const start = this.receivedBytes;
+    for (let i = 0; i < bytes.length; i++) {
+      const byte = bytes[i];
+      if (this.nextStartsLine && !(this.previousCR && byte === 10)) {
+        this.starts[this.lineCount % MAX_PANE_LINES] = start + i;
+        this.lineCount++;
+      }
+      this.previousCR = byte === 13;
+      this.nextStartsLine = this.previousCR || byte === 10;
+    }
+    this.receivedBytes += bytes.byteLength;
+    this.receivedFrames++;
+    this.retainedFrames++;
+    const lineFloor = this.lineCount > MAX_PANE_LINES ? this.starts[this.lineCount % MAX_PANE_LINES]! : 0;
+    const floor = Math.max(0, this.receivedBytes - MAX_PANE_BYTES, lineFloor);
+    const offset = Math.max(0, floor - start);
+    if (!bytes.length && this.last?.bytes.length === 0) {
+      this.last.count++;
+    } else {
+      // Own the surviving bytes. A short suffix must not pin a large input array.
+      this.last = { start: start + offset, bytes: new Uint8Array(bytes.subarray(offset)), count: 1 };
+      this.chunks.set(this.receivedFrames, this.last);
+    }
+    for (const [sequence, chunk] of this.chunks) {
+      if (chunk.start >= floor) break;
+      const lost = floor - chunk.start;
+      if (lost < chunk.bytes.length) {
+        chunk.bytes = chunk.bytes.slice(lost);
+        chunk.start = floor;
+        break;
+      }
+      this.chunks.delete(sequence);
+      this.retainedFrames -= chunk.count;
+    }
+    this.retainedBytes = this.receivedBytes - floor;
+  }
+
+  *frames(): IterableIterator<Uint8Array> {
+    for (const chunk of this.chunks.values()) {
+      for (let i = 0; i < chunk.count; i++) yield chunk.bytes.slice();
+    }
+  }
+
+  text(): string {
+    const decoder = new TextDecoder();
+    let text = "";
+    for (const chunk of this.chunks.values()) text += decoder.decode(chunk.bytes, { stream: true });
+    return text + decoder.decode();
+  }
+}
+
+type Source = Pick<BrokerClient, "output">;
+const streams = new WeakMap<Source, Map<string, PaneStream>>();
+const noSubscription = () => () => {};
+const empty = () => "";
+
+class PaneStream {
+  private readonly buffer = new PaneRetention();
+  private readonly listeners = new Set<() => void>();
+  private started = false;
+  private cached: string | undefined;
+  constructor(private readonly client: Source, private readonly executionId: string) {}
+
+  readonly snapshot = (): string => this.cached ??= this.buffer.text();
+  readonly subscribe = (listener: () => void) => {
+    this.listeners.add(listener);
+    if (!this.started) {
+      this.started = true;
+      void this.consume();
+    }
+    return () => { this.listeners.delete(listener); };
+  };
+
+  private async consume(): Promise<void> {
+    try {
+      for await (const frame of this.client.output(this.executionId)) {
+        if (frame.executionId !== this.executionId) break;
+        this.buffer.append(frame.bytes);
+        this.cached = undefined;
+        for (const notify of this.listeners) notify();
+      }
+    } catch {
+      // Keep the last received bytes. The snapshot subscription owns liveness.
+    }
+  }
+}
+
+/** One consumer per client and execution, including across focus changes and remounts. */
+export function usePaneOutput(client: Source | undefined, executionId: string | undefined): string {
+  let stream: PaneStream | undefined;
+  if (client && executionId) {
+    let executions = streams.get(client);
+    if (!executions) { executions = new Map(); streams.set(client, executions); }
+    stream = executions.get(executionId);
+    if (!stream) {
+      stream = new PaneStream(client, executionId);
+      executions.set(executionId, stream);
+    }
+  }
+  return useSyncExternalStore(stream?.subscribe ?? noSubscription, stream?.snapshot ?? empty);
+}
