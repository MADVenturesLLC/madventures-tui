+import { spyOn } from "bun:test";
+import { copyFileSync, mkdirSync, readFileSync, symlinkSync } from "node:fs";
+import { join, resolve } from "node:path";
+import * as build from "../../packages/supervisor/src/build";
+import { offlineStart } from "./offline";
+
+export async function originalBuildInput() {
+  const f = offlineStart();
+  const repo = resolve(import.meta.dir, "../..");
+  // The Phase 3A harness derives its worktree from its own file. Run an exact
+  // copy in a disposable Git worktree with the checked-out production modules.
+  try {
+    const tree = join(f.work, "test/phase3a");
+    mkdirSync(tree, { recursive: true });
+    for (const name of ["runtime-harness.ts", "fixture-adapters.ts"]) {
+      copyFileSync(join(repo, "test/phase3a", name), join(tree, name));
+    }
+    for (const name of ["packages", "node_modules"]) symlinkSync(join(repo, name), join(f.work, name), "dir");
+    copyFileSync(join(repo, "tsconfig.json"), join(f.work, "tsconfig.json"));
+    const fixtures: typeof import("../phase3a/fixture-adapters") = await import(join(tree, "fixture-adapters.ts"));
+    const harness: typeof import("../phase3a/runtime-harness") = await import(join(tree, "runtime-harness.ts"));
+    const executable = "#!" + process.execPath + "\n" + readFileSync(new URL("./unbridged-stand-in.ts", import.meta.url), "utf8");
+    const script = spyOn(fixtures, "fixtureExecutableSource").mockReturnValue(executable);
+    const original = build.runTransactionalBuildWithDependencies;
+    let state: build.PartialBuildState | undefined;
+    const capture = spyOn(build, "runTransactionalBuildWithDependencies").mockImplementation(async (...args) => {
+      const result = await original(...args);
+      if (result.ok) state = result.state;
+      return result;
+    });
+    try {
+      const session = await harness.startFixtureSession();
+      try {
+        if (!state?.client) throw new Error("original client missing");
+        const raw = state.client;
+        const snapshot = await raw.getSnapshot();
+        const host = state.hosts.find(h => h.executionId === snapshot.activeWriterExecutionId)!;
+        const observe = spyOn(host.handle, "send");
+        try {
+          const result = await raw.request({ kind: "pty_input", commandId: "original-input", sessionId: snapshot.sessionId,
+            executionId: host.executionId, fencingToken: snapshot.fencingToken!, bytes: new TextEncoder().encode("offline") });
+          return { result, writes: observe.mock.calls.length };
+        } finally { observe.mockRestore(); }
+      } finally { await session.close(); }
+    } finally { capture.mockRestore(); script.mockRestore(); }
+  } finally { f.dispose(); }
+}
