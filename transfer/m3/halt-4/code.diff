+import { expect, test } from "bun:test";
+import { act } from "react";
+import { testRender } from "@opentui/react/test-utils";
+import { App } from "../../apps/madbridge/src/tui/App";
+import { PaneRetention } from "../../apps/madbridge/src/tui/live/retention";
+import { offlineCatalog, paneClient } from "./pane-client";
+
+const bytes = (text: string) => new TextEncoder().encode(text);
+const decode = (value: Uint8Array) => new TextDecoder().decode(value);
+
+test("interleaved output reaches each pane and dock in host order", async () => {
+  const feed = paneClient();
+  const view = await testRender(<App client={feed.client} catalogLoader={offlineCatalog} />, { width: 154, height: 35 });
+  try {
+    await view.flush();
+    for (const [id, text] of [["builder", "alpha "], ["reviewer", "tango "], ["builder", "bravo"], ["reviewer", "sierra"]] as const) {
+      await act(async () => { feed.emit(id, bytes(text)); });
+      await view.flush();
+    }
+    function check(stage: string, dock: string) {
+      const lines = view.captureCharFrame().split("\n");
+      expect(lines.filter(line => !line.includes("docked")).join("\n")).toContain(stage);
+      expect(lines.find(line => line.includes("docked"))).toContain(dock);
+    }
+    check("alpha bravo", "tango sierra");
+    await act(async () => { view.mockInput.pressKey("4", { meta: true }); });
+    await view.flush();
+    await view.flush();
+    check("tango sierra", "alpha bravo");
+
+    const buffer = new PaneRetention();
+    for (const part of ["alpha ", "", "bravo"]) buffer.append(bytes(part));
+    expect(Array.from(buffer.frames(), decode)).toEqual(["alpha ", "", "bravo"]);
+  } finally { await act(async () => { feed.close(); view.renderer.destroy(); }); }
+});
+
+test("the line cap drops oldest content and counts received and retained frames and bytes", () => {
+  const buffer = new PaneRetention();
+  buffer.append(bytes("old\r"));
+  buffer.append(bytes("\n"));
+  for (let i = 0; i < 9_999; i++) buffer.append(bytes("x\n"));
+  expect(buffer.text()).toBe("old\r\n" + "x\n".repeat(9_999));
+  buffer.append(bytes("tail"));
+  expect(buffer.receivedFrames).toBe(10_002);
+  expect(buffer.receivedBytes).toBe(20_007);
+  expect(buffer.retainedFrames).toBe(10_000);
+  expect(buffer.retainedBytes).toBe(20_002);
+  expect(buffer.text()).toBe("x\n".repeat(9_999) + "tail");
+  expect(Array.from(buffer.frames()).length).toBe(10_000);
+});
+
+test("the byte cap retains the newest bytes including a partial frame", () => {
+  const buffer = new PaneRetention();
+  buffer.append(bytes("OLD"));
+  const block = new Uint8Array(2_097_150).fill(97);
+  block[0] = 98;
+  block[1] = 99;
+  buffer.append(block);
+  buffer.append(bytes("end"));
+  expect(buffer.receivedFrames).toBe(3);
+  expect(buffer.receivedBytes).toBe(2_097_156);
+  expect(buffer.retainedFrames).toBe(2);
+  expect(buffer.retainedBytes).toBe(2_097_152);
+  const frames = Array.from(buffer.frames());
+  expect(frames.map(frame => frame.byteLength)).toEqual([2_097_149, 3]);
+  expect(frames[0]![0]).toBe(99);
+  expect(decode(frames[1]!)).toBe("end");
+});
