+      executionId: t.writer.execution_id, fencingToken: snapshot.fencingToken!,
+      bytes: encodedLine("madv-surface", "offline mismatched evidence") });
+    expect(mismatch.ok).toBe(true);
+    await observed(() => t.failures.includes("madv-surface identity_mismatch"));
+    expect(t.madvSender!(bytes)).toBe(false);
+  } finally { await t.close(); }
+  expect(t.madvSender).toBeFunction();
