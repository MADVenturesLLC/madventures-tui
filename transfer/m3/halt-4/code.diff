diff --git a/test/phase3b/malformed-observation.ts b/test/phase3b/malformed-observation.ts
new file mode 100644
index 0000000..da81860
--- /dev/null
+++ b/test/phase3b/malformed-observation.ts
@@ -0,0 +1,81 @@
+import { readFileSync } from "node:fs";
+import type { BuildResult } from "../../packages/supervisor/src/index";
+import { MalformedFrameError } from "../../packages/broker/src/pty-host-protocol";
+import { unsafeTestOnlyInjectHostOutput } from "../../packages/broker/src/pty-host-supervisor";
+import type { Surface } from "./end-stand-in";
+import { observed, openTransport } from "./transport";
+
+export const malformedFacts = {
+  payload: Uint8Array.of(0, 0, 0, 2, 1, 1),
+  unknown: Uint8Array.of(0, 0, 0, 1, 255),
+};
+
+// After handover reportFailure exposes the cause. Identify the additional
+// private parser reason from the stop call which actually reported it.
+function madvReasonAtCall(): string | null {
+  const source = readFileSync(new URL("../../packages/adapter-madv-surface/src/live.ts", import.meta.url), "utf8").split("\n");
+  for (const site of (new Error().stack ?? "").matchAll(/packages\/adapter-madv-surface\/src\/live\.ts:(\d+):\d+/g)) {
+    const line = source[Number(site[1]) - 1];
+    const match = line?.match(/catch\s*\{\s*stop\("identity_mismatch",\s*"([^"]+)"/);
+    if (match) return match[1]!;
+  }
+  return null;
+}
+
+export async function malformedObservation(surface: Surface, fault: keyof typeof malformedFacts) {
+  const failure: { parserReason: string | null; decodeError: string | null } = { parserReason: null, decodeError: null };
+  const t = await openTransport(surface, (name, cause) => {
+    if (name === "madv-surface" && cause === "identity_mismatch") failure.parserReason = madvReasonAtCall();
+  });
+  const host = t.build.state.hosts.find(h => h.executionId === t.writer.execution_id)!;
+  const frames: number[][] = [];
+  const receiving = (async () => {
+    for await (const frame of t.client.output(t.writer.execution_id)) frames.push([...frame.bytes]);
+  })();
+
+  async function closeAndDrain(build: BuildResult) {
+    if (!build.ok) throw new Error("expected active fixture");
+    const state = build.state;
+    if ((await t.client.getSnapshot()).phase !== "closed") await state.broker!.founderClose("offline-close");
+    try {
+      for (const entry of state.hosts) {
+        try {
+          for await (const _ of entry.handle.facts()) {}
+        } catch (error) {
+          if (entry !== host || !(error instanceof MalformedFrameError)) throw error;
+          failure.decodeError = error.name + ": " + error.message;
+        }
+      }
+      await observed(() => {
+        try { process.kill(host.hostPid, 0); return false; }
+        catch (error) { if ((error as NodeJS.ErrnoException).code === "ESRCH") return true; throw error; }
+      });
+    } finally {
+      for (const adapter of state.adapters) await adapter.disconnect();
+      await t.client.close();
+      await receiving;
+      state.ledger!.close();
+    }
+  }
+
+  let active = "", endPhase = "", cause: string | null = null;
+  let interruptions: string[] = [];
+  try {
+    active = (await t.client.getSnapshot()).phase;
+    t.release(surface, 1, " \t");
+    await observed(() => frames.length > 0);
+    unsafeTestOnlyInjectHostOutput(host.handle, malformedFacts[fault]);
+    // A genuine stand-in output wakes the supervisor's pending stdout read.
+    t.release(surface, 2, "  \t");
+    const deadline = performance.now() + 1700;
+    do {
+      endPhase = (await t.client.getSnapshot()).phase;
+      if (endPhase === "closed") break;
+      await Bun.sleep(5);
+    } while (performance.now() < deadline);
+    cause = t.failures.find(item => item.startsWith(surface + " ")) ?? null;
+    interruptions = t.build.state.ledger!.readAfter(0).map(row => JSON.parse(row.event_json))
+      .filter(row => row.event_type === "session_interrupted").map(row => String(row.reason_code));
+  } finally { await t.close(closeAndDrain); }
+  return { surface, fault, active, endPhase, ...failure, cause, interruptions, frames };
+}
