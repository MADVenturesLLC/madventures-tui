+import { authorityRows, endedObservation, ownedSource, rendered } from "./ended-observation";
+
+test("failed and closed streams replace current authority in every reader", async () => {
+  for (const end of ["failed read", "closed client"] as const) {
+    const { reads, projection, rows } = await endedObservation(end);
+    expect(reads).toBe(2);
+    expect([projection.connected, projection.ownershipState, projection.activeWriter, projection.fencingToken])
+      .toEqual([false, "owned", "builder", 17]);
+    expect(rows.status).toContain("writer STREAM ENDED");
+    expect(rows.compact).toContain("W:STREAM ENDED");
+    expect(rows.governance).toContain("Writer / Token / Ownership: STREAM ENDED");
+    for (const pane of [rows.claude, rows.madv]) expect(pane).toContain("FOCUSED | STREAM ENDED");
+    for (const dock of [rows.claudeDock, rows.madvDock]) expect(dock).toContain("docked | STREAM ENDED");
+    for (const row of Object.values(rows)) expect(row).not.toMatch(/WRITER |writer builder|W:builder|Ownership: owned|#17|Token: 17/);
+  }
+  const state = clientSnapshotToProjection(ownedSource());
+  const live = await authorityRows(state);
+  expect(live.status).toContain("writer builder #17");
+  expect(live.compact).toContain("W:builder#17");
+  expect(live.governance).toContain("Writer: builder | Token: 17 | Ownership: owned");
+  for (const row of [live.claude, live.claudeDock]) expect(row).toContain("WRITER tok#17");
+  for (const row of [live.madv, live.madvDock]) expect(row).not.toMatch(/WRITER|STREAM ENDED/);
+  const unknown = await authorityRows({ ...state, connected: null });
+  expect(unknown.status).toContain("UNKNOWN | session active");
+  expect(unknown.compact).toContain("UNKNOWN");
+  expect(unknown.governance).toContain("GOVERNANCE | UNKNOWN");
+  for (const row of [unknown.claude, unknown.madv, unknown.claudeDock, unknown.madvDock]) {
+    expect(row).toContain(" | UNKNOWN");
+    expect(row).not.toMatch(/STREAM ENDED|WRITER/);
+  }
+});
+
+test("transfer-requested and sender-released show a null token as absence", async () => {
+  const base = clientSnapshotToProjection(ownedSource());
+  for (const [kind, word] of [["transfer-requested", "transfer-req"], ["sender-released", "released"]] as const) {
+    for (const writer of ["builder", "reviewer"]) {
+      const state = { ...base, ownershipState: kind, activeWriter: writer, fencingToken: null };
+      const rows = await authorityRows(state);
+      expect(rows.status).toContain("writer " + word + " (token —)");
+      expect(rows.compact).toContain("T:—");
+      expect(rows.governance).toContain("Token: — | Ownership: " + kind);
+      const fields = writer === "builder" ? [rows.claude, rows.claudeDock] : [rows.madv, rows.madvDock];
+      for (const field of fields) expect(field).toContain("WRITER token —");
+      const incident = await rendered(<IncidentBand state={{ ...state, sessionState: "interrupted" }} />);
+      expect(incident).toContain("token —");
+      const events = await rendered(<EventLog entries={[{ seq: 1, type: kind, actor: writer,
+        fencingToken: null, hash: "offline", timestamp: "synthetic" }]} />);
+      expect(events).toContain("tok:—");
+      for (const row of [...Object.values(rows), incident, events]) {
+        expect(row).not.toMatch(/(?:tok#|tok:|Token: |WRITER tok#|token )\d|(?:transfer-req|released)\s*#\d/);
+      }
+    }
+  }
+});
