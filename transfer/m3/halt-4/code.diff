index 0000000..3a84df1
--- /dev/null
+++ b/scripts/phase3b/m3-evidence.tsx
@@ -0,0 +1,76 @@
+import { realpathSync, writeFileSync } from "node:fs";
+import { join } from "node:path";
+import { PaneRetention } from "../../apps/madbridge/src/tui/live/retention";
+import { transportSurfaces, orderedTranscript } from "../../test/phase3b/transport";
+import { dispatchTranscript } from "../../test/phase3b/dispatch-observation";
+import { usableInput } from "../../test/phase3b/usable-input";
+import { endedObservation } from "../../test/phase3b/ended-observation";
+import { malformedObservation } from "../../test/phase3b/malformed-observation";
+
+function retentionTranscript() {
+  const bytes = (s: string) => new TextEncoder().encode(s);
+  const counts = (buffer: PaneRetention) => ({
+    receivedFrames: buffer.receivedFrames, receivedBytes: buffer.receivedBytes,
+    retainedFrames: buffer.retainedFrames, retainedBytes: buffer.retainedBytes,
+  });
+  const lines = new PaneRetention();
+  lines.append(bytes("old\r"));
+  lines.append(bytes("\n"));
+  for (let i = 0; i < 9_999; i++) lines.append(bytes("x\n"));
+  const atLines = counts(lines);
+  lines.append(bytes("tail"));
+  const size = new PaneRetention();
+  size.append(bytes("OLD"));
+  const block = new Uint8Array(2_097_149).fill(97);
+  size.append(block);
+  const atBytes = counts(size);
+  size.append(bytes("end"));
+  return [
+    { limit: "lines", atLimit: atLines, after: counts(lines), start: lines.text().slice(0, 2), end: lines.text().slice(-4) },
+    { limit: "bytes", atLimit: atBytes, after: counts(size), start: size.text().slice(0, 3), end: size.text().slice(-3) },
+  ];
+}
+
+async function main(destination: string) {
+  const root = realpathSync(destination);
+  const transcripts = new Map<string, unknown[]>();
+  function record(name: string, observation: unknown) {
+    const rows = transcripts.get(name) ?? [];
+    rows.push(observation);
+    transcripts.set(name, rows);
+  }
+  for (const surface of transportSurfaces) {
+    record("ordered-frames", { surface, frames: await orderedTranscript(surface) });
+    record("transport", await dispatchTranscript(surface));
+    for (const nonwriter of [false, true]) {
+      const result = await usableInput(surface, nonwriter);
+      const expected = nonwriter ? "UNAUTHORIZED" : '"offlineReply":"proof"';
+      if (!result.render.includes(expected)) throw new Error("missing offline presentation");
+      record("usable-input", result);
+    }
+    for (const fault of ["payload", "unknown"] as const) {
+      const result = await malformedObservation(surface, fault);
+      if (!result.decodeError || result.interruptions.join() !== "identity_mismatch") throw new Error("missing decoder interruption");
+      record("malformed-frames", result);
+    }
+  }
+  for (const counts of retentionTranscript()) record("retention", counts);
+  for (const end of ["failed read", "closed client"] as const) {
+    const { reads, projection, rows } = await endedObservation(end);
+    record("ended-streams", { end, reads, connected: projection.connected,
+      retained: { writer: projection.activeWriter, ownership: projection.ownershipState, token: projection.fencingToken },
+      readers: Object.fromEntries(Object.entries(rows).map(([reader, text]) =>
+        [reader, text.split("\n").find(row => row.includes("STREAM ENDED"))?.trim() ?? ""])) });
+  }
+  for (const [name, rows] of transcripts) {
+    const filename = name + ".jsonl";
+    writeFileSync(join(root, filename), rows.map(row => JSON.stringify(row)).join("\n") + "\n", { flag: "wx", mode: 0o600 });
+    console.log(filename, rows.length);
+  }
+}
+
+if (import.meta.main) {
+  const destination = process.argv[2];
+  if (!destination) throw new Error("expected an offline evidence directory");
+  await main(destination);
+}
