@@ -0,0 +1,25 @@
+import { expect, spyOn, test } from "bun:test";
+import * as supervisor from "../../packages/supervisor/src/index";
+import { SNAPSHOT_INTERVAL_MS } from "../../packages/supervisor/src/snapshot-timer";
+import { subscribeToClient } from "../../apps/madbridge/src/tui/live/subscribe";
+import { ownedSource, snapshotReader } from "./ended-observation";
+
+test("unsubscribe settles the pending pacing wait before its deadline", async () => {
+  const wait = spyOn(supervisor, "waitForSnapshotTick");
+  const first = Promise.withResolvers<void>();
+  const off = subscribeToClient(snapshotReader(async () => ownedSource()))(() => first.resolve());
+  try {
+    await first.promise;
+    expect(wait).toHaveBeenCalledTimes(1);
+    const pending = wait.mock.results[0]!.value as Promise<void>;
+    let settled = false;
+    void pending.then(() => { settled = true; });
+    await Promise.resolve();
+    expect(settled).toBe(false);
+    const start = performance.now();
+    off();
+    await Promise.resolve();
+    expect(settled).toBe(true);
+    expect(performance.now() - start).toBeLessThan(SNAPSHOT_INTERVAL_MS / 2);
+  } finally { off(); wait.mockRestore(); }
+});
