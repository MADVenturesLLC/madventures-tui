+import { expect, test } from "bun:test";
+import { unsafeTestOnlyIngestRawOutputFrame } from "../../packages/broker/src/in-process-client";
+import { openTransport, orderedTranscript, transportSurfaces } from "./transport";
+
+test("the live producer delivers contiguous monitor facts for each execution and excludes attestation", async () => {
+  for (const surface of transportSurfaces) {
+    const executionId = surface === "claude-code" ? "builder" : "reviewer";
+    expect(await orderedTranscript(surface)).toEqual([
+      { sessionId: "offline-transport", executionId, outputSeq: 1, bytes: [32, 9] },
+      { sessionId: "offline-transport", executionId, outputSeq: 2, bytes: [32, 32, 9] },
+    ]);
+  }
+}, 20000);
+
+test("a refused output sequence interrupts the live session", async () => {
+  for (const surface of transportSurfaces) {
+    const t = await openTransport(surface);
+    try {
+      const frame = { sessionId: t.sessionId, executionId: t.writer.execution_id, outputSeq: 2, bytes: Uint8Array.of(42) };
+      await expect(unsafeTestOnlyIngestRawOutputFrame(t.client, frame)).rejects.toThrow();
+      const rows = t.build.state.ledger!.readAfter(0).map(row => JSON.parse(row.event_json));
+      expect(rows.filter(e => e.event_type === "session_interrupted").map(e => e.reason_code))
+        .toEqual(["output_sequence_invariant_failed"]);
+    } finally { await t.close(); }
+  }
+}, 20000);
