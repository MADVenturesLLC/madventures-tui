@@ -0,0 +1,39 @@
+import { act } from "react";
+import type { BrokerCommand, OutputFrame } from "@madventures/broker";
+import { subscribeToClient } from "../../apps/madbridge/src/tui/live/subscribe";
+import type { Surface } from "./end-stand-in";
+import { inputView } from "./input-view";
+import { openTransport } from "./transport";
+
+export async function usableInput(surface: Surface, nonwriter = false) {
+  const t = await openTransport(surface);
+  try {
+    const frames: OutputFrame[] = [], requests: BrokerCommand[] = [];
+    const focused = nonwriter ? (surface === "claude-code" ? "madv-surface" : "claude-code") : surface;
+    const v = await inputView({
+      getSnapshot: t.client.getSnapshot, subscribe: subscribeToClient(t.client),
+      async *output(id) {
+        for await (const frame of t.client.output(id)) { frames.push(frame); yield frame; }
+      },
+      request(command) { requests.push(command); return t.client.request(command); },
+    });
+    try {
+      await v.key(focused === "madv-surface" ? "4" : "1", true);
+      await v.line("proof");
+      // Capture the actual pane even on a broken path. The test must reach
+      // its byte, destination and rendering assertions with that observation.
+      const marker = nonwriter ? "UNAUTHORIZED" : '"offlineReply":"proof"';
+      const deadline = performance.now() + 3500;
+      let render = "";
+      do {
+        await act(async () => { await Bun.sleep(5); });
+        await v.flush();
+        render = v.captureCharFrame().split("\n").find(row => row.includes(marker)) ?? "";
+      } while (!render && performance.now() < deadline);
+      return { writer: surface, focused, render: render.trim(), failures: t.failures.slice(),
+        child: t.inputs(focused), otherChild: t.inputs(focused === "madv-surface" ? "claude-code" : "madv-surface"),
+        inputs: requests.filter(c => c.kind === "pty_input").map(c => ({ executionId: c.executionId, bytes: [...c.bytes] })),
+        frames: frames.map(frame => ({ executionId: frame.executionId, outputSeq: frame.outputSeq, text: new TextDecoder().decode(frame.bytes) })) };
+    } finally { await v.close(); }
+  } finally { await t.close(); }
+}
