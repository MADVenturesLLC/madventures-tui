+import type { BrokerCommand, BrokerResult, BrokerSnapshot, ExecutionSnapshot, OutputFrame } from "@madventures/broker";
+import { parseSurfaceId } from "@madventures/protocol";
+import type { PaneClient } from "../../apps/madbridge/src/tui/App";
+import { clientSnapshotToProjection } from "../../apps/madbridge/src/tui/live/projection";
+import { sparseSnapshot } from "./snapshot-input";
+
+function execution(id: string, surface: string): ExecutionSnapshot {
+  return {
+    identity: { execution_id: id, surface: parseSurfaceId(surface), role: id === "builder" ? "builder" : "independent-reviewer",
+      model: id + "-model", provider: "offline", independence_domain: id, effort: "high" },
+    state: "ready", hostPid: null, childPid: null, processGroupId: null, executablePath: "", executableSha256: "",
+    exitCode: null, exitSignal: null,
+  };
+}
+
+export function paneSnapshot(overrides: Partial<BrokerSnapshot> = {}): BrokerSnapshot {
+  return { ...sparseSnapshot, sessionId: "offline-panes", connected: true, phase: "active", snapshotSeq: 1,
+    executions: [execution("builder", "claude-code"), execution("reviewer", "madv-surface")],
+    activeWriterExecutionId: "builder", tokenState: "valid", fencingToken: 17, ...overrides };
+}
+
+export function paneClient(snapshot = paneSnapshot()) {
+  type Listener = Parameters<PaneClient["subscribe"]>[0];
+  const listeners = new Set<Listener>();
+  const commands: BrokerCommand[] = [];
+  const readers = new Map<string, (frame: OutputFrame | null) => void>();
+  const sequences = new Map<string, number>();
+  const client: PaneClient = {
+    subscribe(listener) {
+      listeners.add(listener);
+      listener(clientSnapshotToProjection(snapshot));
+      return () => { listeners.delete(listener); };
+    },
+    getSnapshot: async () => snapshot,
+    async *output(id) {
+      while (true) {
+        const frame = await new Promise<OutputFrame | null>(resolve => readers.set(id, resolve));
+        if (!frame) return;
+        yield frame;
+      }
+    },
+    async request(command): Promise<BrokerResult> {
+      commands.push(command);
+      return { ok: true, commandId: command.commandId, acceptedSnapshotSeq: 1 };
+    },
+  };
+  return {
+    client, commands,
+    setSnapshot(next: BrokerSnapshot) {
+      snapshot = next;
+      for (const notify of listeners) notify(clientSnapshotToProjection(next));
+    },
+    emit(id: string, bytes: Uint8Array) {
+      const reader = readers.get(id);
+      if (!reader) throw new Error("offline reader unavailable");
+      readers.delete(id);
+      const outputSeq = (sequences.get(id) ?? 0) + 1;
+      sequences.set(id, outputSeq);
+      reader({ sessionId: snapshot.sessionId, executionId: id, outputSeq, bytes });
+    },
+    close() { for (const reader of readers.values()) reader(null); },
+  };
+}
+
+export const offlineCatalog = async () => ({ status: "ok" as const, models: [] });
