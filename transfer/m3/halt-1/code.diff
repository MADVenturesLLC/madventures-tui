+import { appendFileSync, existsSync, readFileSync, writeFileSync } from "node:fs";
+import { basename, dirname, join } from "node:path";
+import { attestationEvents, type Surface } from "./end-stand-in";
+
+async function run(): Promise<void> {
+  const executable = process.argv[1]!;
+  const root = dirname(dirname(executable));
+  if (!process.stdin.isTTY || process.cwd() !== join(root, "work") || !existsSync(join(root, "m3-transport"))) {
+    throw new Error("expected a private transport stand-in");
+  }
+  const surface: Surface = basename(executable).startsWith("madbridge-claude-v5") ? "claude-code" : "madv-surface";
+  const model = process.argv[process.argv.indexOf("--model") + 1]!;
+  const events = attestationEvents(surface, model);
+  const emit = (items: readonly unknown[], tail = "") =>
+    writeFileSync(1, items.map(item => JSON.stringify(item) + "\n").join("") + tail);
+
+  let attested = false;
+  let next = 1;
+  const control = setInterval(() => {
+    if (!attested) return;
+    const file = join(root, surface + "-output-" + next);
+    if (!existsSync(file)) return;
+    writeFileSync(1, readFileSync(file));
+    next++;
+  }, 5);
+  try {
+    let pending = Buffer.alloc(0);
+    for await (const chunk of process.stdin) {
+      pending = Buffer.concat([pending, chunk]);
+      let end: number;
+      while ((end = pending.indexOf(10)) >= 0) {
+        const wire = pending.subarray(0, end + 1);
+        pending = pending.subarray(end + 1);
+        const message = JSON.parse(wire.toString("utf8"));
+        if (!attested) {
+          if (message.message?.content !== "Reply with your model identifier and nothing else." ||
+              (surface === "madv-surface" ? message.no_tools !== true : message.no_tools !== undefined)) {
+            throw new Error("unexpected attestation message");
+          }
+          // The whitespace following the result is a partial line in this same read.
+          emit(events, " ");
+          attested = true;
+        } else {
+          // Bun caches terminal dimensions until a resize notification is serviced.
+          const terminal = process.stdout as typeof process.stdout & { _refreshSize(): void };
+          terminal._refreshSize();
+          const observation = { bytes: [...wire], cols: process.stdout.columns, rows: process.stdout.rows };
+          appendFileSync(join(root, surface + "-inputs"), JSON.stringify(observation) + "\n");
+          const reply = message.message.content;
+          emit(events.slice(1).map(event => ({ ...event, offlineReply: reply,
+            ...(reply === "offline mismatched evidence" && event.type === "model_response" && { response_model: "MiniMax-offline-other" }),
+          })));
+        }
+      }
+    }
+  } finally { clearInterval(control); }
+}
+
+if (import.meta.main) await run();
