+import { expect, spyOn, test } from "bun:test";
+import { closeStdinCallCountForTest } from "../../packages/broker/src/pty-host-supervisor";
+import { dispatchTranscript, encodedLine } from "./dispatch-observation";
+import { observed, openTransport, transportSurfaces } from "./transport";
+import { originalBuildInput } from "./unbridged";
+
+test("both host commands reach the child and wait for the matching ack", async () => {
+  for (const surface of transportSurfaces) {
+    const result = await dispatchTranscript(surface);
+    expect(result.frames).toEqual([
+      { kind: "resize", pending: true, cols: 73, rows: 19 },
+      { kind: "input", pending: true, bytes: result.expected },
+    ]);
+    expect(result.child).toEqual({ bytes: result.expected, cols: 73, rows: 19 });
+    expect(result.outcomes).toEqual((["pty_resize", "pty_input"] as const).map(kind => ({
+      kind, registered: true, answeredWhileStopped: false, acceptedAfterResume: true,
+    })));
+  }
+}, 20_000);
+
+function exists(pid: number): boolean {
+  try { process.kill(pid, 0); return true; }
+  catch (error) { if ((error as NodeJS.ErrnoException).code === "ESRCH") return false; throw error; }
+}
+
+test("a missed acknowledgement contains the stopped host and interrupts the session", async () => {
+  for (const surface of transportSurfaces) {
+    for (const kind of ["pty_resize", "pty_input"] as const) {
+      const t = await openTransport(surface);
+      const host = t.build.state.hosts.find(h => h.executionId === t.writer.execution_id)!;
+      const child = t.build.state.children.find(c => c.executionId === host.executionId)!;
+      const members = t.build.state.children.flatMap(c => [c.hostPid, c.childPid!, -c.pgid!]);
+      const kill = process.kill.bind(process);
+      const kills: { pid: number; at: number }[] = [];
+      const watch = spyOn(process, "kill").mockImplementation((pid, signal) => {
+        if (signal === "SIGKILL") kills.push({ pid, at: performance.now() });
+        return kill(pid, signal);
+      });
+      try {
+        const snapshot = await t.client.getSnapshot();
+        const base = { sessionId: t.sessionId, commandId: "offline-wedge", fencingToken: snapshot.fencingToken!,
+          executionId: host.executionId };
+        const command = kind === "pty_input" ? { ...base, kind, bytes: encodedLine(surface, "offline wedge") }
+          : { ...base, kind, cols: 61, rows: 17 };
+        kill(host.hostPid, "SIGSTOP");
+        const started = performance.now();
+        const result = await t.client.request(command);
+        expect(result).toMatchObject({ ok: false, error: "host_unavailable" });
+        expect(closeStdinCallCountForTest(host.handle)).toBeGreaterThan(0);
+        for (const pid of [-child.pgid!, host.hostPid]) {
+          const sent = kills.find(k => k.pid === pid);
+          expect(sent).toBeDefined();
+          expect(sent!.at - started).toBeGreaterThanOrEqual(249);
+          expect(sent!.at - started).toBeLessThanOrEqual(500);
+        }
+        await observed(() => !members.some(exists));
+        expect(performance.now() - started).toBeLessThanOrEqual(5000);
+        const rows = t.build.state.ledger!.readAfter(0).map(row => JSON.parse(row.event_json));
+        expect(rows.filter(e => e.event_type === "session_interrupted").map(e => e.reason_code)).toEqual(["pty_host_failure"]);
+      } finally {
+        watch.mockRestore();
+        // In a deliberately broken run the stopped host can still need resuming.
+        if (!kills.some(k => k.pid === host.hostPid) && exists(host.hostPid)) kill(host.hostPid, "SIGCONT");
+        await t.close();
+      }
+    }
+  }
+}, 35_000);
+
+test("execution clients and the original build have no host bridge", async () => {
+  for (const surface of transportSurfaces) {
+    const t = await openTransport(surface);
+    try {
+      const snapshot = await t.client.getSnapshot();
+      const host = t.build.state.hosts.find(h => h.executionId === t.writer.execution_id)!;
+      const writes = spyOn(host.handle, "send");
+      try {
+        for (const adapter of t.build.state.adapters) {
+          const result = await adapter.client.request({ kind: "pty_input", commandId: "offline-execution",
+            sessionId: t.sessionId, executionId: host.executionId, fencingToken: snapshot.fencingToken!,
+            bytes: encodedLine(surface, "offline execution") });
+          expect(result.ok).toBe(true);
+        }
+        expect(writes.mock.calls).toHaveLength(0);
+        expect(t.inputs(surface)).toEqual([]);
+        host.handle.closeStdin();
+        const unavailable = await t.client.request({ kind: "pty_resize", commandId: "offline-host-closed",
+          sessionId: t.sessionId, executionId: host.executionId, fencingToken: snapshot.fencingToken!, cols: 51, rows: 16 });
+        expect(unavailable).toMatchObject({ ok: false, error: "host_unavailable" });
+        expect(writes.mock.calls).toHaveLength(0);
+      } finally { writes.mockRestore(); }
+    } finally { await t.close(); }
+  }
+  const original = await originalBuildInput();
+  expect(original.result.ok).toBe(true);
+  expect(original.writes).toBe(0);
+}, 25_000);
+
+test("the madv byte sender begins a checked request and refuses a closed monitor", async () => {
+  const t = await openTransport("madv-surface");
+  const bytes = encodedLine("madv-surface", "offline checked request");
+  try {
+    const snapshot = await t.client.getSnapshot();
+    const receive = (async () => {
+      let text = "";
+      for await (const frame of t.client.output(t.writer.execution_id)) {
+        text += new TextDecoder().decode(frame.bytes);
+        if (text.includes('"type":"result"')) return text;
+      }
+      throw new Error("offline result missing");
+    })();
+    const answer = await t.client.request({ kind: "pty_input", commandId: "offline-check", sessionId: t.sessionId,
+      executionId: t.writer.execution_id, fencingToken: snapshot.fencingToken!, bytes });
+    expect(answer.ok).toBe(true);
+    expect(await receive).toContain('"offlineReply":"offline checked request"');
+    expect(t.failures).toEqual([]);
+    expect((await t.client.getSnapshot()).phase).toBe("active");
+    const mismatch = await t.client.request({ kind: "pty_input", commandId: "offline-mismatch", sessionId: t.sessionId,
+      executionId: t.writer.execution_id, fencingToken: snapshot.fencingToken!,
+      bytes: encodedLine("madv-surface", "offline mismatched evidence") });
+    expect(mismatch.ok).toBe(true);
+    await observed(() => t.failures.includes("madv-surface identity_mismatch"));
+    expect(t.madvSender!(bytes)).toBe(false);
+  } finally { await t.close(); }
+  expect(t.madvSender).toBeFunction();
+  expect(t.madvSender!(bytes)).toBe(false);
+}, 12_000);
