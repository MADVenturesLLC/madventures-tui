+// Private Phase 3A fixture child and probes. Never record a process environment.
+import { basename } from "node:path";
+if (import.meta.main) {
+  if (process.argv.includes("--fixture-run")) {
+    process.on("SIGTERM", () => process.exit(0));
+    process.stdin.setRawMode(true);
+    process.stdin.on("data", data => process.stdout.write(data));
+    process.stdin.on("end", () => process.exit(0));
+    process.stdout.write("FIXTURE_READY\n");
+  } else if (process.argv.includes("--fixture-auth")) {
+    console.log(JSON.stringify({ loggedIn: true, authMethod: "claude.ai", apiProvider: "firstParty", subscriptionType: "max" }));
+  } else {
+    const model = basename(process.argv[1]!) === "fixture-builder" ? "fixture-model-0" : "fixture-model-1";
+    console.log(JSON.stringify({ type: "system", subtype: "init", model, claude_code_version: "1.0.0" }));
+  }
+}
