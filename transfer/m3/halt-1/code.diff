--- /dev/null
+++ b/test/phase3b/transport.ts
@@ -0,0 +1,90 @@
+import { existsSync, readFileSync, writeFileSync } from "node:fs";
+import { join } from "node:path";
+import { parseTaskEnvelope, sha256CanonicalSync } from "@madventures/protocol";
+import type { OutputFrame } from "@madventures/broker";
+import { createStartAttesters } from "../../apps/madbridge/src/tui/live/composition";
+import { runLiveTransactionalBuild, runPurePreflight } from "../../packages/supervisor/src/index";
+import type { Surface } from "./end-stand-in";
+import { prepareM2 } from "./m2-offline";
+import { closeOfflineBuild } from "./offline";
+
+export const transportSurfaces = ["claude-code", "madv-surface"] as const;
+export async function observed(predicate: () => boolean | Promise<boolean>): Promise<void> {
+  const limit = performance.now() + 3500;
+  while (!await predicate()) {
+    if (performance.now() >= limit) throw new Error("offline observation deadline");
+    await Bun.sleep(5);
+  }
+}
+
+export async function openTransport(surface: Surface) {
+  const f = prepareM2(surface, false, "Founder close");
+  try {
+    writeFileSync(join(f.root, "m3-transport"), "");
+    writeFileSync(join(f.bin, "end-stand-in.ts"), readFileSync(new URL("./end-stand-in.ts", import.meta.url)));
+    for (const child of f.plan.executions) {
+      writeFileSync(child.executablePath + ".launch.ts", readFileSync(new URL("./transport-stand-in.ts", import.meta.url)));
+    }
+    const writer = f.envelope.executions.find(e => e.surface === surface)!;
+    const { envelope_hash: _hash, ...body } = f.envelope;
+    const unsigned = { ...body, initial_writer: writer.execution_id };
+    const envelope = parseTaskEnvelope({ ...unsigned, envelope_hash: sha256CanonicalSync(unsigned) });
+    const preflight = await runPurePreflight({ ...f.input, envelope: { ...envelope } });
+    if (!preflight.ok) throw new Error("offline transport preflight " + preflight.failure);
+    const sessionId = "offline-transport";
+    const failures: string[] = [];
+    const installed = createStartAttesters();
+    let madvSender: ((bytes: Uint8Array) => boolean) | undefined;
+    const build = await runLiveTransactionalBuild({
+      sessionId, envelope, plan: preflight.plan, signal: f.input.signal,
+      attesterFor: name => {
+        const attest = installed(name);
+        if (!attest) return undefined;
+        return async input => {
+          const verdict = await attest({ ...input, reportFailure(cause) {
+            failures.push(name + " " + cause);
+            input.reportFailure(cause);
+          } });
+          if (name === "madv-surface" && verdict.ok) madvSender = verdict.sendEncodedInput;
+          return verdict;
+        };
+      },
+    });
+    if (!build.ok) {
+      await closeOfflineBuild(build);
+      throw new Error("offline transport build " + build.detail);
+    }
+    const client = build.state.client!;
+    function release(target: Surface, sequence: number, bytes: string) {
+      writeFileSync(join(f.root, target + "-output-" + sequence), bytes);
+    }
+    function inputs(target: Surface): { bytes: number[]; cols: number; rows: number }[] {
+      const file = join(f.root, target + "-inputs");
+      return existsSync(file) ? readFileSync(file, "utf8").trim().split("\n").map(line => JSON.parse(line)) : [];
+    }
+    async function close() {
+      try { await closeOfflineBuild(build); } finally { f.dispose(); }
+    }
+    return { root: f.root, build, client, envelope, sessionId, failures, writer, release, inputs, close, madvSender };
+  } catch (error) { f.dispose(); throw error; }
+}
+
+export async function orderedTranscript(surface: Surface) {
+  const t = await openTransport(surface);
+  try {
+    const frames: OutputFrame[] = [];
+    const receive = (async () => {
+      for await (const frame of t.client.output(t.writer.execution_id)) {
+        frames.push(frame);
+        if (frames.length === 2) break;
+      }
+    })();
+    t.release(surface, 1, " \t");
+    await observed(() => frames.length > 0);
+    t.release(surface, 2, "  \t");
+    await observed(() => frames.length === 2);
+    await receive;
+    return frames.map(frame => ({ sessionId: frame.sessionId, executionId: frame.executionId,
+      outputSeq: frame.outputSeq, bytes: [...frame.bytes] }));
+  } finally { await t.close(); }
+}
