@@ -0,0 +1,31 @@
+import { expect, test } from "bun:test";
+import { encodedLine } from "./dispatch-observation";
+import { transportSurfaces } from "./transport";
+import { usableInput } from "./usable-input";
+
+test("each submitted stream-json line produces a checked stand-in response in its pane", async () => {
+  for (const surface of transportSurfaces) {
+    const r = await usableInput(surface);
+    const id = surface === "claude-code" ? "builder" : "reviewer";
+    const bytes = [...encodedLine(surface, "proof")];
+    expect(r.inputs).toEqual([{ executionId: id, bytes }]);
+    expect(r.child).toHaveLength(1);
+    expect(r.child[0]!.bytes).toEqual(bytes);
+    expect(r.otherChild).toEqual([]);
+    expect(r.frames.filter(f => f.executionId === id).map(f => f.text).join("")).toContain('"offlineReply":"proof"');
+    expect(r.render).toContain('"offlineReply":"proof"');
+    expect(r.failures).toEqual([]);
+  }
+}, 25_000);
+
+test("a nonwriter submission is unauthorized in its pane and never reaches the child", async () => {
+  for (const surface of transportSurfaces) {
+    const r = await usableInput(surface, true);
+    const id = surface === "claude-code" ? "reviewer" : "builder";
+    expect(r.inputs).toEqual([{ executionId: id, bytes: [...encodedLine(r.focused, "proof")] }]);
+    expect(r.child).toEqual([]);
+    expect(r.otherChild).toEqual([]);
+    expect(r.render).toContain("UNAUTHORIZED");
+    expect(r.frames).toEqual([]);
+  }
+}, 25_000);
