{
  "name": "madventures-tui",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun run --watch apps/madbridge/src/tui/App.tsx",
    "build": "tsc --noEmit",
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test",
    "verify": "bunx tsc --noEmit && bun test",
    "madv-tui": "bun run apps/madbridge/src/cli.ts",
    "broker": "bun run packages/broker/src/broker.ts",
    "mcp": "bun run packages/broker/src/mcp-server.ts",
    "test:tui-chaos": "bun packages/tui-chaos/src/cli.ts run"
  },
  "trustedDependencies": [
    "node-pty"
  ],
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.2.18",
    "@types/react-test-renderer": "^19.1.0",
    "react-test-renderer": "^19.2.8"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@opentui/core": "^0.5.1",
    "@opentui/react": "^0.5.1",
    "react": "^19.2.6"
  }
}
