{
  "name": "madventures-tui",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun run --watch apps/madbridge/src/tui/App.tsx",
    "build": "tsc --noEmit",
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test",
    "verify": "bunx tsc --noEmit && bunx tsc --noEmit -p apps/projector-mc && bunx tsc --noEmit -p apps/seal-studio && bun test",
    "projector": "bun run --cwd apps/projector-mc dev",
    "projector:build": "bun run --cwd apps/projector-mc build",
    "seal-studio": "bun run --cwd apps/seal-studio dev",
    "seal-studio:build": "bun run --cwd apps/seal-studio build",
    "madv-tui": "bun run apps/madbridge/src/cli.ts",
    "broker": "bun run packages/broker/src/broker.ts",
    "mcp": "bun run packages/broker/src/mcp-server.ts",
    "test:tui-chaos": "bun packages/tui-chaos/src/cli.ts run",
    "preflight": "bun packages/preflight/src/cli.ts",
    "founder-act": "bun packages/founder-act/src/main.ts",
    "honesty-compile": "bun packages/honesty-compiler/src/cli.ts"
  },
  "trustedDependencies": [
    "node-pty"
  ],
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.2.18",
    "@types/react-test-renderer": "^19.1.0",
    "react-test-renderer": "^19.2.8"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@opentui/core": "^0.5.1",
    "@opentui/react": "^0.5.1",
    "react": "^19.2.6"
  }
}
